generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email             String   @unique
  password_hash     String
  is_email_verified Boolean  @default(false)
  created_at        DateTime @default(now())

  userGroups    UserGroup[]
  transactions  Transaction[]
  tokens        UserToken[]

  @@map("users")
}

model Group {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  
  users          UserGroup[]
  transactions   Transaction[]
  installments   Installment[]
  fixed_expenses FixedExpense[]
  savings        Savings?

  @@map("groups")
}

model UserGroup {
  id       String @id @default(uuid())
  user_id  String
  group_id String
  role     String @default("MEMBER") // "OWNER" or "MEMBER"
  status   String @default("PENDING") // "PENDING" or "ACCEPTED"

  user     User   @relation(fields: [user_id], references: [id])
  group    Group  @relation(fields: [group_id], references: [id])

  @@map("user_groups")
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  icon       String?  // Ex: "home", "food", "car"
  color      String?  // Ex: "#FF0000"
  created_at DateTime @default(now())

  transactions   Transaction[]
  fixed_expenses FixedExpense[]

  @@map("categories")
}

model Installment {
  id                 String   @id @default(uuid())
  group_id           String
  total_amount       Float
  installments_count Int
  description        String
  created_at         DateTime @default(now())

  group        Group         @relation(fields: [group_id], references: [id])
  transactions Transaction[]

  @@map("installments")
}

model FixedExpense {
  id           String   @id @default(uuid())
  group_id     String
  category_id  String
  amount       Float
  description  String
  day_of_month Int      // Dia do vencimento, ex: 10
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  group        Group         @relation(fields: [group_id], references: [id])
  category     Category      @relation(fields: [category_id], references: [id])
  transactions Transaction[]

  @@map("fixed_expenses")
}

model Transaction {
  id               String   @id @default(uuid())
  group_id         String
  user_id          String   
  category_id      String
  installment_id   String?
  fixed_expense_id String?
  amount           Float
  type             String   // "INCOME" ou "EXPENSE"
  description      String
  date             DateTime // Data em que a transação ocorreu
  is_paid          Boolean  @default(true) // Controle de pendência
  created_at       DateTime @default(now())

  group        Group         @relation(fields: [group_id], references: [id])
  user         User          @relation(fields: [user_id], references: [id])
  category     Category      @relation(fields: [category_id], references: [id])
  installment  Installment?  @relation(fields: [installment_id], references: [id])
  fixedExpense FixedExpense? @relation(fields: [fixed_expense_id], references: [id])

  @@map("transactions")
}

model Savings {
  id          String   @id @default(uuid())
  group_id    String   @unique
  amount      Float
  updated_at  DateTime @updatedAt

  group       Group    @relation(fields: [group_id], references: [id])

  @@map("savings")
}

model UserToken {
  id         String   @id @default(uuid())
  token      String
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}