generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())

  userGroups    UserGroup[]
  transactions  Transaction[]

  @@map("users")
}

model Group {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  
  users        UserGroup[]
  transactions Transaction[]
  installments Installment[]

  @@map("groups")
}

model UserGroup {
  id       String @id @default(uuid())
  user_id  String
  group_id String
  role     String @default("MEMBER") // "OWNER" or "MEMBER"
  status   String @default("PENDING") // "PENDING" or "ACCEPTED"

  user     User   @relation(fields: [user_id], references: [id])
  group    Group  @relation(fields: [group_id], references: [id])

  @@map("user_groups")
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  icon       String?  // Ex: "home", "food", "car"
  color      String?  // Ex: "#FF0000"
  created_at DateTime @default(now())

  transactions Transaction[]

  @@map("categories")
}

model Installment {
  id                 String   @id @default(uuid())
  group_id           String
  total_amount       Float
  installments_count Int
  description        String
  created_at         DateTime @default(now())

  group        Group         @relation(fields: [group_id], references: [id])
  transactions Transaction[]

  @@map("installments")
}

model Transaction {
  id             String   @id @default(uuid())
  group_id       String
  user_id        String   
  category_id    String
  installment_id String?
  amount         Float
  type           String   // "INCOME" ou "EXPENSE"
  description    String
  date           DateTime // Data em que a transação ocorreu
  is_paid        Boolean  @default(true) // Controle de pendência
  created_at     DateTime @default(now())

  group       Group        @relation(fields: [group_id], references: [id])
  user        User         @relation(fields: [user_id], references: [id])
  category    Category     @relation(fields: [category_id], references: [id])
  installment Installment? @relation(fields: [installment_id], references: [id])

  @@map("transactions")
}